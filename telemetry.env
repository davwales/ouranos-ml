# Points a source run at the local telemetry stack in compose.yml:
#   podman compose up -d
#   uv run --env-file telemetry.env opentelemetry-instrument ouranos_ml
# Production values live in deploy/ouranos-ml.container.
LOKI_BASE_URL=http://localhost:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=ouranos-ml
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=Development
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=health
OTEL_PYTHON_HTTPX_EXCLUDED_URLS=.*loki/api/v1/push.*
